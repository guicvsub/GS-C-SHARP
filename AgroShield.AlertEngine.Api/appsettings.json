{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5050"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=#{DB_SERVER}#;Database=#{DB_NAME}#;User=#{DB_USER}#;Password=#{DB_PASSWORD}#;SslMode=None;AllowPublicKeyRetrieval=True"
  }
}
